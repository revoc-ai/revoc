# Copy this file to .env before running docker compose up.
#
# In mock mode (REVOC_UPSTREAM__MOCK_MODE=true, set in docker-compose.yml)
# the proxy returns a synthetic response and never calls an upstream provider,
# so OPENAI_API_KEY is optional. Set it to route real traffic.
OPENAI_API_KEY=sk-your-key-here

# To route to Anthropic instead, set:
# ANTHROPIC_API_KEY=sk-ant-your-key-here
