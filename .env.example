# ─────────────────────────────────────────────────────────────────────────────
# REVOC — Runtime Execution Validation & Observability Control
# Environment variable reference.
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production, inject these as container environment variables or use a
# secrets manager (Vault, AWS Secrets Manager, GCP Secret Manager).
# Never commit a .env file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

## ── Upstream Providers ───────────────────────────────────────────────────────
## API keys for the AI providers REVOC proxies to.
## Only set the keys for providers you actually use.
## In mock mode (REVOC_UPSTREAM__MOCK_MODE=true) these are not required.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic — https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI — https://portal.azure.com
# Also set REVOC_UPSTREAM__PROVIDERS__AZURE__BASE_URL in your config
AZURE_OPENAI_API_KEY=

## ── Auth ─────────────────────────────────────────────────────────────────────
## Controls who can send requests through the REVOC proxy.
## auth.mode in revoc.toml determines which of these is used.

# Comma-separated list of API keys that clients must present in Authorization header.
# Format: Bearer <key>   or   x-api-key: <key>
# Generate a key with: cargo run --bin revoc-proxy -- generate-key --label myapp
# Used when auth.mode = "apikey"
REVOC_API_KEYS=revoc-dev-key-change-me

# Path to a file containing one API key per line (preferred over env in production).
# Used when auth.mode = "apikey" and this is set (takes precedence over REVOC_API_KEYS).
REVOC_API_KEYS_FILE=

# JWT secret for signing and verifying JWT tokens.
# Must be at least 32 bytes of random data.
# Generate with: openssl rand -hex 32
# Used when auth.mode = "jwt"
REVOC_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Admin key for the internal management API (port 8081).
# Required for kill-switch activation and deactivation.
# Generate with: openssl rand -hex 24
REVOC_ADMIN_KEY=dev-admin-key-change-me

# HMAC key signing the kill-switch state. Required when REDIS_URL is set
# (state is shared by every instance; use the same key on all of them).
# At least 32 bytes. Generate with: openssl rand -hex 32
REVOC_KILL_SWITCH_KEY=

## ── Storage ──────────────────────────────────────────────────────────────────
## REVOC stores audit events and policy bundles in SQLite (Tier 1) or
## Postgres (Tier 2/3). Set one of the following.

# Full Postgres connection URL.
# Used when storage.backend = "postgres" in revoc.toml.
# Format: postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=postgres://revoc:revoc@localhost:5432/revoc

# Path to the SQLite audit database file.
# Used when storage.backend = "sqlite" (default for Tier 1).
# Defaults to "revoc-audit.db" in the working directory if not set.
REVOC_SQLITE_PATH=revoc-audit.db

## ── Redis ────────────────────────────────────────────────────────────────────
## Redis is used for:
##   - Kill-switch propagation across instances (pub/sub on revoc:kill_switch)
##   - Policy decision cache (when cache.backend = "redis")
##   - Session state storage (when session.enabled = true, Tier 2+)
## Required for Tier 2 (docker-compose) and Tier 3 (Helm). Optional for Tier 1.

# Redis connection URL.
# Format: redis://[:password@]host[:port][/db]
#         rediss://... for TLS
REDIS_URL=redis://localhost:6379

# Redis password (if your Redis instance requires AUTH).
# Alternatively embed in REDIS_URL: redis://:password@host:port
REDIS_PASSWORD=

## ── Telemetry ────────────────────────────────────────────────────────────────
## OpenTelemetry tracing and metrics export.
## Leave REVOC_OTLP_ENDPOINT empty to disable OTel (Prometheus still works).

# gRPC endpoint for the OpenTelemetry collector.
# Example: http://otel-collector:4317
# Leave empty to disable trace/metric export (local Prometheus still active).
REVOC_OTLP_ENDPOINT=

## ── Webhooks ─────────────────────────────────────────────────────────────────
## REVOC can POST governance events to external webhook endpoints.
## Configure endpoints in revoc.toml [[webhooks.endpoints]].

# HMAC-SHA256 secret used to sign webhook payloads.
# Receivers verify with: HMAC-SHA256(secret, request_body) == X-Revoc-Signature
REVOC_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32

## ── Audit ────────────────────────────────────────────────────────────────────
## Optional encryption for audit event values at rest.
## When set, sensitive fields in audit_events are AES-256-GCM encrypted.

# 32-byte (256-bit) AES encryption key, hex-encoded (64 hex chars).
# Generate with: openssl rand -hex 32
# Leave empty to store audit data unencrypted (still no PII values — only
# entity types and positions are stored per SPEC.md §23 Rule 2).
REVOC_AUDIT_ENCRYPTION_KEY=
