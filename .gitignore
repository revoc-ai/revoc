# ─────────────────────────────────────────────────────────────────────────────
# REVOC .gitignore
# Rust + Python + Node.js + IDE + OS
# IMPORTANT: crates/revoc-dashboard/ui/dist/ is NOT ignored — it must be
#            committed so the single-container image works without a Node build.
# ─────────────────────────────────────────────────────────────────────────────

# ── Rust ──────────────────────────────────────────────────────────────────────
/target/
debug/
**/*.rs.bk
*.pdb
**/mutants.out*/

# ── Fuzz ──────────────────────────────────────────────────────────────────────
# Keep: fuzz/Cargo.toml, fuzz/Cargo.lock, fuzz/fuzz_targets/, fuzz/artifacts/
# Ignore: compiled binaries and generated corpus (too large, too noisy)
fuzz/target/
fuzz/corpus/

# ── Cargo Chef artifacts ──────────────────────────────────────────────────────
recipe.json
req.json

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
api_keys.txt
api-keys.txt

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
*.egg-info/
.eggs/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn/
.pnp.*
# Build output for SDK packages (NOT for revoc-dashboard/ui/dist — see below)
sdk/node/dist/
sdk/node/lib/

# ── Dashboard React SPA ───────────────────────────────────────────────────────
# CRITICAL: DO NOT add crates/revoc-dashboard/ui/dist/ here.
# The pre-built SPA must be committed to git so the Rust binary can embed it
# via include_dir! without requiring a Node build step in the container.
crates/revoc-dashboard/ui/node_modules/
crates/revoc-dashboard/ui/.parcel-cache/
crates/revoc-dashboard/ui/.vite/

# ── Database & Storage ────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
revoc-audit.db*

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── ML Models ────────────────────────────────────────────────────────────────
# ONNX models and tokenizer files are large binaries — downloaded via models/download.sh
models/*.onnx
models/*.json
!models/README.md
!models/download.sh

# ── Test Artifacts ───────────────────────────────────────────────────────────
# Locust CSV output and load test result files — generated on every run
tests/load/results/

# ── Generated / Build Artifacts ───────────────────────────────────────────────
site/
lcov.info
lcov-*.info
coverage/
*.profraw
*.profdata

# ── Claude IDE local settings ─────────────────────────────────────────────────
.claude/settings.local.json

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
.fleet/
.zed/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Helm ──────────────────────────────────────────────────────────────────────
helm/revoc/charts/
helm/revoc/*.tgz

# ── Misc ──────────────────────────────────────────────────────────────────────
.cargo-ok
flamegraph.svg
perf.data
perf.data.old
heaptrack.*
massif.out.*
dist/
build/
# CRITICAL: revoc-dashboard pre-built SPA must be committed (SPEC.md §6)
!crates/revoc-dashboard/ui/dist/
!crates/revoc-dashboard/ui/dist/**
